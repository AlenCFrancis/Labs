import numpy as np
import matplotlib.pyplot as plt
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split
import pandas as pd
import time

from google.colab import files

uploaded = files.upload()


df = pd.read_csv('/content/fashion-mnist_train.csv')

print("Dataset shape:", df.shape)
print(df.head())

y = df['label'].values
X = df.drop('label', axis=1).values

X = X / 255.0

X_train_f, X_test_f, y_train_f, y_test_f = train_test_split(
    X, y,
    test_size=2000,
    train_size=10000,
    random_state=42,
    stratify=y
)

print("Training samples:", X_train_f.shape)
print("Testing samples:", X_test_f.shape)


class_names = [
    'T-shirt', 'Trouser', 'Pullover', 'Dress', 'Coat',
    'Sandal', 'Shirt', 'Sneaker', 'Bag', 'Ankle boot'
]


k_values = [1, 3, 5, 7, 9, 11]
results = []

for k in k_values:
    t0 = time.time()

    clf = KNeighborsClassifier(
        n_neighbors=k,
        n_jobs=-1
    )

    clf.fit(X_train_f, y_train_f)

    y_pred = clf.predict(X_test_f)

    acc = accuracy_score(y_test_f, y_pred)

    elapsed = time.time() - t0

    results.append((k, acc, elapsed))

    print(f'K={k:2d} Acc={acc:.4f} Time={elapsed:.1f}s')

ks, accs, _ = zip(*results)

plt.plot(ks, accs, marker='o')
plt.xlabel('K')
plt.ylabel('Accuracy')
plt.title('KNN Accuracy vs K – Fashion MNIST')
plt.tight_layout()
plt.show()
